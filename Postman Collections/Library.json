				{
					"listen": "test",
					"script": {
						"id": "c4c8acc4-0157-4de9-ab7b-9ee7cb5cafb7",
						"exec": [
							"// Fixed errors in test scripts\r",
							"const jsonData = pm.response.json();\r",
							"pm.test(\"Validate Status Code is 200\", function() {\r",
							"    pm.response.to.have.status(200);\r",
							"    pm.expect(jsonData).to.have.property(\"Msg\");\r",
							"    pm.expect(jsonData.Msg).to.eql(\"successfully added\");\r",
							"});\r",
							"\r",
							"pm.test(\"Header cookies responstime validation\", function() {\r",
							"    pm.response.to.have.header(\"Content-Type\");\r",
							"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"application/json;charset=UTF-8\");\r",
							"    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
							"    pm.expect(pm.response.text()).to.include(\"successfully added\");\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"id": "e9039c75-5361-4023-bc78-49f5c1150bd7",
						"exec": [
							"//RS45464\r",
							"// gives access to all global variables and gets \"companyCode\"\r",
							"// Remember to SAVE the variable in global \r",
							"console.log(pm.globals.get(\"companyCode\")); \r",
							"// store the global variable in a constant \r",
							"const code = pm.globals.get(\"companyCode\");\r",
							"// use an appropriate dynamic variable from the Postman; in this case, $randomInt\r",
							"const val = pm.variables.replaceIn('{{$randomInt}}');\r",
							"// create the \"isbn\" variable in LiBrary collection environment \r",
							"//Concatenate the constants; in this instance, place in the collection level\r",
							"pm.collectionVariables.set(\"isbn\",code + val);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
